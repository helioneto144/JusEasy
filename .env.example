# ──────────────────────────────────────────
# Supabase (banco de dados)
# Crie um projeto gratuito em https://supabase.com
# Project Settings > API para obter URL e anon key
# ──────────────────────────────────────────
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ──────────────────────────────────────────
# AASP (intimações — necessário para advogados associados à AASP/SP)
# Obtenha sua chave em: https://www.aasp.org.br
# ──────────────────────────────────────────
AASP_API_KEY=sua-chave-aasp-aqui
AASP_API_URL=https://intimacaoapi.aasp.org.br

# ──────────────────────────────────────────
# Telegram Bot
# 1. Abra o Telegram e converse com @BotFather
# 2. Use /newbot e siga as instruções
# 3. Para obter o CHAT_ID: envie uma mensagem ao bot e acesse
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=seu-token-aqui
TELEGRAM_CHAT_ID=seu-chat-id-aqui

# ──────────────────────────────────────────
# IA via Groq (resumo automático de intimações e comando /ia)
# Chave gratuita em: https://console.groq.com
# ──────────────────────────────────────────
GROQ_API_KEY=sua-chave-groq-aqui
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Usada pelo comando /ia (pode ser a mesma chave Groq)
AI_API_KEY=sua-chave-groq-aqui
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# ──────────────────────────────────────────
# Webhook (Cloudflare Email Worker → JusEasy)
# Token aleatório (>= 32 chars) compartilhado com o Worker.
# Gere com: openssl rand -hex 32
# ──────────────────────────────────────────
WEBHOOK_SECRET=

# ──────────────────────────────────────────
# Feature flags — captura de intimações
# ──────────────────────────────────────────
AASP_ENABLED=true        # legacy AASP API (será desligado quando OAB-ES funcionar)
OAB_ES_ENABLED=false     # ativa processamento de emails OAB-ES (Fase 3)

# ──────────────────────────────────────────
# Configurações gerais
# ──────────────────────────────────────────
POLLING_INTERVAL_HOURS=3
TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000
